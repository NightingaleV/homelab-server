# ──────────────────────────────────────────────
# General
# ──────────────────────────────────────────────
TZ=Europe/Prague
DOCKER_VOLUME_STORAGE=/mnt/nas/DockerServices
PUID=1000
PGID=1000

# ──────────────────────────────────────────────
# PostgreSQL
# ──────────────────────────────────────────────
POSTGRES_DB=paperless
POSTGRES_USER=paperless
POSTGRES_PASSWORD=changeme          # CHANGE THIS

# ──────────────────────────────────────────────
# Paperless-ngx
# ──────────────────────────────────────────────
PAPERLESS_SECRET_KEY=changeme-use-a-long-random-string   # CHANGE THIS — python -c "import secrets; print(secrets.token_urlsafe(64))"
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=changeme   # CHANGE THIS — initial superuser password
PAPERLESS_URL=https://paperless.slavik.tech
PAPERLESS_PORT=8010
PAPERLESS_OCR_LANGUAGE=eng
# PAPERLESS_OCR_LANGUAGES=ces       # additional Tesseract language packs to install (space-separated)

# ──────────────────────────────────────────────
# Paperless API Token
# Generated AFTER first login: Profile → API Tokens → Generate
# Required by Paperless-AI and Paperless-GPT
# ──────────────────────────────────────────────
PAPERLESS_API_TOKEN=               # paste token here after initial setup

# ──────────────────────────────────────────────
# Ollama (reuses existing ai-server instance)
# ──────────────────────────────────────────────
OLLAMA_API_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b

# ──────────────────────────────────────────────
# Paperless-AI
# ──────────────────────────────────────────────
PAPERLESS_AI_PORT=8020
AI_PROVIDER=ollama
SCAN_INTERVAL=*/30 * * * *         # cron: every 30 minutes

# ──────────────────────────────────────────────
# Paperless-GPT
# ──────────────────────────────────────────────
PAPERLESS_GPT_PORT=8030
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b
LLM_LANGUAGE=English
VISION_LLM_PROVIDER=ollama
VISION_LLM_MODEL=minicpm-v:8b
OLLAMA_CONTEXT_LENGTH=8192
TOKEN_LIMIT=1000
PAPERLESS_GPT_LOG_LEVEL=INFO

# ──────────────────────────────────────────────
# Dozzle (log viewer)
# ──────────────────────────────────────────────
DOZZLE_PORT=8040
