# Pocket ID Configuration
# See the documentation for more information: https://pocket-id.org/docs/configuration/environment-variables

# =============================================================================
# REQUIRED CONFIGURATION
# =============================================================================

# The public URL where Pocket ID will be accessible
# IMPORTANT: Must use HTTPS as Pocket ID requires a secure context for WebAuthn/Passkeys
APP_URL=https://pocket-id.slavik.tech

# Domain for Traefik routing (optional, defaults to pocket-id.slavik.tech in compose.yaml)
POCKET_ID_DOMAIN=pocket-id.slavik.tech

# Encryption key for securing sensitive data (including private keys)
# Generate with: openssl rand -base64 32
# IMPORTANT: Keep this secret and backed up! Losing it means losing access to encrypted data
ENCRYPTION_KEY=

# Alternative: Use file-based key (recommended for production)
# Put the base64 key in a file and uncomment the line below
# ENCRYPTION_KEY_FILE=/path/to/encryption_key

# =============================================================================
# OPTIONAL CONFIGURATION
# =============================================================================

# Enable reverse proxy support (required when running behind Traefik)
TRUST_PROXY=true

# MaxMind GeoLite2 License Key for IP geolocation features (optional)
# Sign up at https://dev.maxmind.com/geoip/geolite2-free-geolocation-data
MAXMIND_LICENSE_KEY=

# User and Group IDs for file permissions
# Run `id` on your host to find the correct values
PUID=1000
PGID=1000

# =============================================================================
# STORAGE CONFIGURATION
# =============================================================================

# Docker volume storage path (inherited from parent environment)
# Default: /mnt/nas/DockerServices
DOCKER_VOLUME_STORAGE=/mnt/nas/DockerServices

# =============================================================================
# DATABASE CONFIGURATION (Optional - defaults to SQLite)
# =============================================================================

# Pocket ID uses SQLite by default at data/pocket-id.db
# For PostgreSQL, uncomment and configure:
# DB_CONNECTION_STRING=postgres://username:password@host:5432/database_name

# =============================================================================
# ADVANCED CONFIGURATION (Optional)
# =============================================================================

# Disable rate limiting (only if you have your own rate limiting in reverse proxy)
# RATE_LIMIT_DISABLED=false

# Static API key for admin access (useful for declarative installations)
# ADMIN_API_KEY=

# Disable UI configuration (force all config via environment variables)
# UI_CONFIG_DISABLED=false

# Session duration in minutes before re-authentication is required
# SESSION_DURATION_MINUTES=43200

# Application name displayed in the UI
# APP_NAME=Pocket ID

# Enable JSON logging format
# LOG_JSON=false

# Disable analytics
# ANALYTICS_DISABLED=false
