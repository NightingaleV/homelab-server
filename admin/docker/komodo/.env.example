####################################
# 🦎 KOMODO - ENVIRONMENT CONFIG 🦎 #
####################################

#====================#
#= General Settings =#
#====================#

## Image tag: use 'latest' or pin to specific version (e.g., v1.15.0)
COMPOSE_KOMODO_IMAGE_TAG=latest

## Timezone for schedules - https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Europe/Prague

#=====================#
#= Database Settings =#
#=====================#

## MongoDB credentials (change these!)
KOMODO_DB_USERNAME=admin
KOMODO_DB_PASSWORD=CHANGE_ME_HERE

#========================#
#= Security & Auth Keys =#
#========================#

## Passkey for Core <-> Periphery authentication (generate with: openssl rand -hex 32)
KOMODO_PASSKEY=CHANGE_ME_HERE

## Webhook authentication secret (generate with: openssl rand -hex 32)
KOMODO_WEBHOOK_SECRET=CHANGE_ME_HERE

## JWT signing secret (generate with: openssl rand -hex 32)
KOMODO_JWT_SECRET=CHANGE_ME_HERE

## JWT token lifetime: 1-hr, 12-hr, 1-day, 3-day, 1-wk, 2-wk
KOMODO_JWT_TTL=1-day

#======================#
#= Komodo Core Config =#
#======================#

## Public URL for Komodo (used for OAuth callbacks, webhooks)
KOMODO_HOST=https://komodo.slavik.tech

## Browser tab title
KOMODO_TITLE=Komodo Homelab

## First server to create on startup (points to local Periphery container)
KOMODO_FIRST_SERVER=https://periphery:8120
KOMODO_FIRST_SERVER_NAME=Proxy-Server

## Skip confirmation dialogs (double-click instead)
KOMODO_DISABLE_CONFIRM_DIALOG=false

## Monitoring interval: 1-sec, 5-sec, 15-sec, 1-min, 5-min, 15-min
KOMODO_MONITORING_INTERVAL=15-sec

## Resource poll interval: 15-min, 1-hr, 2-hr, 6-hr, 12-hr, 1-day
KOMODO_RESOURCE_POLL_INTERVAL=1-hr

#==================#
#= Authentication =#
#==================#

## Enable local username/password login
KOMODO_LOCAL_AUTH=true

## Initial admin account (created on first launch)
KOMODO_INIT_ADMIN_USERNAME=admin
KOMODO_INIT_ADMIN_PASSWORD=CHANGE_ME_HERE

## User registration settings
KOMODO_DISABLE_USER_REGISTRATION=true
KOMODO_ENABLE_NEW_USERS=false
KOMODO_DISABLE_NON_ADMIN_CREATE=false

## Transparent mode: all users get read access to all resources
KOMODO_TRANSPARENT_MODE=false

#========================#
#= OAuth (Optional) =#
#========================#

## GitHub OAuth
KOMODO_GITHUB_OAUTH_ENABLED=false
# KOMODO_GITHUB_OAUTH_ID=
# KOMODO_GITHUB_OAUTH_SECRET=

## Google OAuth
KOMODO_GOOGLE_OAUTH_ENABLED=false
# KOMODO_GOOGLE_OAUTH_ID=
# KOMODO_GOOGLE_OAUTH_SECRET=

## OIDC (e.g., Authentik, Keycloak)
KOMODO_OIDC_ENABLED=false
# KOMODO_OIDC_PROVIDER=https://oidc.provider.internal/application/o/komodo
# KOMODO_OIDC_CLIENT_ID=
# KOMODO_OIDC_CLIENT_SECRET=

#============================#
#= Periphery Agent Settings =#
#============================#

## Root directory for Periphery data (must match inside/outside container)
PERIPHERY_ROOT_DIRECTORY=/etc/komodo

## Passkeys that Periphery accepts (must include KOMODO_PASSKEY)
PERIPHERY_PASSKEYS=${KOMODO_PASSKEY}

## Enable SSL (self-signed) - connect via https://address:8120
PERIPHERY_SSL_ENABLED=true

## Terminal access via web UI
PERIPHERY_DISABLE_TERMINALS=false

## Disk mount filtering for accurate disk size reporting
PERIPHERY_INCLUDE_DISK_MOUNTS=/etc/hostname
# PERIPHERY_EXCLUDE_DISK_MOUNTS=/snap,/etc/repos

#============#
#= Logging =#
#============#

KOMODO_LOGGING_PRETTY=false
KOMODO_PRETTY_STARTUP_CONFIG=false
PERIPHERY_LOGGING_PRETTY=false
PERIPHERY_PRETTY_STARTUP_CONFIG=false

#================#
#= AWS (Optional) =#
#================#

## For launching Builder instances on AWS
# KOMODO_AWS_ACCESS_KEY_ID=
# KOMODO_AWS_SECRET_ACCESS_KEY=
