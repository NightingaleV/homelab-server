#############################################
# 🦎 KOMODO PERIPHERY AGENT - ENV CONFIG 🦎 #
#############################################

#====================#
#= General Settings =#
#====================#

## Image tag: use 'latest' or pin to specific version (e.g., v1.15.0)
COMPOSE_KOMODO_IMAGE_TAG=latest

## Timezone for schedules - https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Europe/Prague

#============================#
#= Periphery Agent Settings =#
#============================#

## Root directory for Periphery data (must match inside/outside container)
PERIPHERY_ROOT_DIRECTORY=/etc/komodo

## Passkeys that Periphery accepts (must match KOMODO_PASSKEY in Core)
PERIPHERY_PASSKEYS=CHANGE_ME_MATCHES_KOMODO_PASSKEY

## Enable SSL (self-signed) - connect via https://address:8120
PERIPHERY_SSL_ENABLED=true

## Terminal access via web UI
PERIPHERY_DISABLE_TERMINALS=false

## Include only specific disk mounts for accurate disk size reporting
PERIPHERY_INCLUDE_DISK_MOUNTS=/etc/hostname

## Optional: restrict access to trusted source IPs / CIDRs
# PERIPHERY_ALLOWED_IPS=192.168.68.90/32

## Optional: exclude mount paths from disk reporting
# PERIPHERY_EXCLUDE_DISK_MOUNTS=/snap,/etc/repos

## Optional: explicit bind IP if needed for networking compatibility
# PERIPHERY_BIND_IP=0.0.0.0
